{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "contract_version",
    "created_at",
    "nodes",
    "edges"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sourceNode"
          },
          {
            "$ref": "#/$defs/evidenceNode"
          },
          {
            "$ref": "#/$defs/entityNode"
          }
        ]
      },
      "maxItems": 10000
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 50000
    }
  },
  "$defs": {
    "commonNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "maxLength": 128
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "number",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "sourceNode": {
      "allOf": [
        {
          "$ref": "#/$defs/commonNode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "label",
            "recorded_at",
            "source_record_id",
            "canonical_url"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "type": {
              "const": "source"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64,
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "metadata": {
              "type": "object",
              "maxProperties": 50,
              "propertyNames": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minProperties": 0
            },
            "source_record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "canonical_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/@\\s?#]+(?:/[^#\\s]*)?(?:\\?[^#\\s]*)?$",
              "maxLength": 2048
            }
          }
        }
      ]
    },
    "evidenceNode": {
      "allOf": [
        {
          "$ref": "#/$defs/commonNode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "label",
            "recorded_at",
            "evidence_record_id",
            "sha256",
            "observed_at",
            "source_node_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "type": {
              "const": "evidence"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64,
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "metadata": {
              "type": "object",
              "maxProperties": 50,
              "propertyNames": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minProperties": 0
            },
            "evidence_record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64,
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "source_node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        }
      ]
    },
    "entityNode": {
      "allOf": [
        {
          "$ref": "#/$defs/commonNode"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "label",
            "recorded_at",
            "entity_record_id",
            "entity_kind",
            "resolution_status"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "type": {
              "const": "entity"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64,
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "metadata": {
              "type": "object",
              "maxProperties": 50,
              "propertyNames": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "number",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minProperties": 0
            },
            "entity_record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "entity_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "resolution_status": {
              "enum": [
                "provisional",
                "resolved",
                "disputed",
                "withdrawn"
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "predicate",
        "evidence_refs",
        "confidence",
        "uncertainty",
        "observed_at",
        "recorded_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    }
  }
}
